<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if pageTitle %}{{ pageTitle }} — {{ siteHe.title }}{% else %}{{ siteHe.title }}{% endif %}</title>
  <meta name="description" content="{{ pageDescription or siteHe.description }}">
  {% set root = page.url | rootPath %}
  <link rel="icon" type="image/jpeg" href="{{ root }}/assets/images/favicon.jpg">
  <link rel="stylesheet" href="{{ root }}/he/assets/css/style.css">
  <link rel="alternate" type="application/rss+xml" title="{{ siteHe.title }} RSS" href="{{ root }}/he/feed.xml">
  <link rel="preconnect" href="https://pub-702fe332080547d2b53b7ffe91657707.r2.dev" crossorigin>
  <link rel="dns-prefetch" href="https://pub-702fe332080547d2b53b7ffe91657707.r2.dev">
  <link rel="preconnect" href="https://app.arnavnavon.com" crossorigin>
  <link rel="dns-prefetch" href="https://app.arnavnavon.com">
</head>
<body>

  <div id="flex-container">

    <!-- Fixed Sidebar -->
    <div id="sidebar">

      <a href="{{ root }}/he/" class="site-branding">
        <div class="site-title">{{ siteHe.title }}</div>
        <img src="{{ root }}/assets/images/logo.png" alt="{{ siteHe.title }}" class="site-logo">
      </a>

      <!-- Search -->
      <div class="sidebar-section">
        <h2>חיפוש</h2>
        <form class="search-form" action="{{ root }}/he/search/" method="get" onsubmit="return sidebarSearch(event)">
          <input type="text" id="sidebarSearchInput" placeholder="חיפוש…" autocomplete="off">
          <button type="submit" aria-label="חיפוש">&#128269;</button>
        </form>
      </div>

      <!-- Subscribe -->
      <div class="sidebar-section" id="subscribeSection">
        <h2>הרשמה</h2>
        <p class="sidebar-small" style="margin:0 0 10px;color:#666">קבלו גישה מוקדמת ותוכן בלעדי.</p>

        <form class="subscribe-form" onsubmit="return handleSubscribe(event)" id="subscribeForm">
          <input type="email" name="email" placeholder="כתובת המייל שלך, ואז Enter" required autocomplete="email">
        </form>

        <div class="sidebar-small" id="signupMsg" style="display:none;"></div>

        <form id="subscribeProfile" style="display:none;margin-top:10px;border-top:1px dashed #ddd;padding-top:10px" onsubmit="return handleSubscribeProfile(event)">
          <p class="sidebar-small" style="margin:0 0 8px;color:#333"><strong>ספרו לנו עוד קצת</strong> <span style="color:#888">(לא חובה)</span></p>

          <label class="sub-label">שם</label>
          <input type="text" name="name" placeholder="השם שלך" autocomplete="name">

          <label class="sub-label" style="margin-top:8px">טווח גילאים</label>
          <select name="age_range">
            <option value="">— דלג —</option>
            <option>18-24</option>
            <option>25-34</option>
            <option>35-44</option>
            <option>45-54</option>
            <option>55-64</option>
            <option>65+</option>
          </select>

          <label class="sub-label" style="margin-top:8px">תחומי עניין</label>
          <div class="sub-chips">
            <label class="sub-chip"><input type="checkbox" name="interests" value="Creativity &amp; Writing"> יצירה וכתיבה</label>
            <label class="sub-chip"><input type="checkbox" name="interests" value="Business &amp; Entrepreneurship"> עסקים</label>
            <label class="sub-chip"><input type="checkbox" name="interests" value="Investing &amp; Money"> השקעות</label>
            <label class="sub-chip"><input type="checkbox" name="interests" value="Parenting &amp; Family"> הורות</label>
            <label class="sub-chip"><input type="checkbox" name="interests" value="Philosophy &amp; Ideas"> פילוסופיה</label>
            <label class="sub-chip"><input type="checkbox" name="interests" value="Personal Development"> צמיחה אישית</label>
            <label class="sub-chip"><input type="checkbox" name="interests" value="Technology"> טכנולוגיה</label>
            <label class="sub-chip"><input type="checkbox" name="interests" value="Health &amp; Habits"> בריאות</label>
          </div>

          <div style="display:flex;gap:6px;margin-top:10px">
            <button type="submit">שמירה</button>
            <button type="button" onclick="document.getElementById('subscribeProfile').style.display='none'" style="background:transparent;border:0;color:#888;cursor:pointer;font-size:12px">דלג</button>
          </div>
        </form>
      </div>


      <!-- Navigation -->
      <div class="sidebar-section">
        <h2>ניווט</h2>
        <div class="sidebar-nav">
          <a href="{{ root }}/he/">ראשי</a>
          <a href="{{ root }}/he/archive/">ארכיון</a>
          <a href="{{ root }}/he/categories/">קטגוריות</a>
          <a href="{{ root }}/he/search/">חיפוש</a>
          <a href="{{ root }}/he/about/">אודות</a>
          <a href="{{ root }}/he/feed.xml">RSS</a>
        </div>
      </div>

    </div>

    <!-- Content Area -->
    <div id="content-container">
      <main id="content">
        {{ content | safe }}
      </main>
    </div>

  </div>

  <script>
    // cookieless page-view count (Cloudflare worker /api/hit — no cookies, no IP stored)
    (function(){try{var q=new URLSearchParams(location.search),s={landing:location.pathname,ref:document.referrer||''};
    ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid'].forEach(function(k){var v=q.get(k);if(v)s[k]=v.slice(0,150);});
    var b=JSON.stringify({path:location.pathname,ref:document.referrer||'',src:s});
    if(navigator.sendBeacon)navigator.sendBeacon('/api/hit',new Blob([b],{type:'text/plain'}));}catch(e){}})();
  </script>

  <script src="{{ root }}/he/assets/js/app.js"></script>

  <script>
    (function(){
      try {
        var TRACK = 'https://app.arnavnavon.com/track';
        var eventId = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2));
        var qs = new URLSearchParams(location.search);
        var base = {
          url: location.pathname,
          ref: document.referrer || '',
          event_id: eventId,
          utm_source: qs.get('utm_source'),
          utm_medium: qs.get('utm_medium'),
          utm_campaign: qs.get('utm_campaign')
        };
        function send(extra) {
          var body = JSON.stringify(Object.assign({}, base, extra || {}));
          var blob = new Blob([body], {type: 'text/plain'});
          if (navigator.sendBeacon) navigator.sendBeacon(TRACK, blob);
          else fetch(TRACK, {method: 'POST', body: blob, keepalive: true, mode: 'no-cors'}).catch(function(){});
        }
        send(); // initial beacon — creates the row
        // Track max scroll + active reading time, send on tab-hide / page-unload.
        var maxScroll = 0;
        var startMs = Date.now();
        var activeMs = 0;
        var lastTickMs = Date.now();
        var visible = document.visibilityState === 'visible';
        function tick() {
          var now = Date.now();
          if (visible) activeMs += (now - lastTickMs);
          lastTickMs = now;
          // Update scroll depth
          var scrolled = window.scrollY || document.documentElement.scrollTop;
          var docHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight) - window.innerHeight;
          if (docHeight > 0) {
            var pct = Math.min(100, Math.round((scrolled / docHeight) * 100));
            if (pct > maxScroll) maxScroll = pct;
          } else {
            maxScroll = Math.max(maxScroll, 100);
          }
        }
        setInterval(tick, 1000);
        document.addEventListener('scroll', tick, {passive: true});
        document.addEventListener('visibilitychange', function(){
          tick();
          visible = document.visibilityState === 'visible';
          if (!visible) send({scroll_depth: maxScroll, read_seconds: Math.round(activeMs / 1000)});
        });
        window.addEventListener('pagehide', function(){
          tick();
          send({scroll_depth: maxScroll, read_seconds: Math.round(activeMs / 1000)});
        });
      } catch(e) {}
    })();
  </script>

</body>
</html>
